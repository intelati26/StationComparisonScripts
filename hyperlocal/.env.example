# same names as StationComparisonScripts; the existing .env there can be copied here
AMBIENT_API_KEY=
AMBIENT_APP_KEY=
AMBIENT_STATION_MAC=
WEATHER_LAT=
WEATHER_LON=
WEATHER_DB_PATH=weather_archive.db
HYPERLOCAL_VALLEY_FT=
HYPERLOCAL_RIM_FT=
HYPERLOCAL_STATION=
HYPERLOCAL_AMP=
# the predicted low is shifted by this many F (0: the bias depends on the forecast the tool is fed; see EQUATION.md) and shown with +- this standard deviation (F)
HYPERLOCAL_BIAS=0.0
HYPERLOCAL_SD=2.8
# a file for `low.py --log`: one JSON line per run, so the nights can be scored against the station
HYPERLOCAL_LOG=
HYPERLOCAL_TD_ADJUST=
